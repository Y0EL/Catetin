{
  "expo": {
    "name": "Catetin",
    "slug": "catetin",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "catetin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.catetin.app"
    },
    "android": {
      "package": "com.catetin.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-image-picker", "expo-av"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
